{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    // Turbo hands a task nothing it was not told about, and the daemon resolves
    // its serial port and its socket from these. Left off, it opens the default
    // device and quietly drives the wrong board.
    "start": {
      "persistent": true,
      "cache": false,
      "env": ["CLAUDE_STATUS_BRIGHTNESS", "CLAUDE_STATUS_PORT", "CLAUDE_STATUS_SOCKET"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "env": ["CLAUDE_STATUS_BRIGHTNESS", "CLAUDE_STATUS_PORT", "CLAUDE_STATUS_SOCKET"]
    }
  }
}
