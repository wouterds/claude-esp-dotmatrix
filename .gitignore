node_modules

build/
.turbo
.env

.DS_Store

# PlatformIO's build tree and its downloaded toolchains. Hundreds of megabytes
# per platform, restored by `pio run`.
firmware/.pio/

# Local agent state - worktrees and machine-specific settings. What is committed
# is the wiring: the settings that grant a session permission to drive the
# display, the hooks that follow the session, and a symlink to the skills, which
# live in .agents/ and stay reviewable.
#
# The directory is allowed back in first. A global gitignore excluding `.claude/`
# is common, git will not descend into an excluded directory, and no negation
# inside one can re-include anything until the directory itself is permitted -
# which presents as these files simply never showing up in `git status`.
!.claude/
.claude/*
!.claude/hooks/
!.claude/settings.json
!.claude/skills

# Where the daemon keeps its socket and pid. Runtime state of one machine.
/.run/
