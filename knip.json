{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreBinaries": ["pio"],
  "workspaces": {
    ".": {
      "entry": [".claude/hooks/*.mjs"]
    },
    "packages/tools": {
      "ignoreDependencies": ["tsx"]
    }
  }
}
